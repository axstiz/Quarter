# LLM-провайдер (change 027): gigachat | ollama | none
POSTCODE_LLM_PROVIDER=gigachat

# GigaChat (provider=gigachat)
# Личный ключ физлица (API Team): GIGACHAT_CLIENT_SECRET = Authorization Key как есть,
# GIGACHAT_CLIENT_ID оставить пустым, scope = GIGACHAT_API_PERS
# CORP (SberBusiness): заполнить ОБА поля (client_id и client_secret), scope = GIGACHAT_API
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
# GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# Ollama (provider=ollama, локально)
POSTCODE_OLLAMA_BASE_URL=http://localhost:11434
POSTCODE_OLLAMA_MODEL=qwen2.5:7b-instruct
